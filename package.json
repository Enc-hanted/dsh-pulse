{
  "name": "dsh-pulse",
  "version": "0.6.0",
  "description": "Cross-session usage & cost observatory for dsh — daily token charts, cache hit ring, 90d/1y heatmaps, model and project breakdowns, adaptive color themes and CSV export in the web UI",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enc-hanted/dsh-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/Enc-hanted/dsh-pulse/issues"
  },
  "homepage": "https://github.com/Enc-hanted/dsh-pulse#readme",
  "exports": {
    ".": "./src/index.js",
    "./aggregate": "./src/aggregate.js",
    "./view": "./src/view.js",
    "./client": "./lib/client.js",
    "./tui": "./src/tui.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "scripts/build-client.mjs",
    "test",
    "assets/pulse.svg",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "usage",
    "analytics",
    "dashboard",
    "heatmap"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "demo": "node scripts/build-canvas-demo.mjs",
    "shots": "node scripts/shoot-canvas-matrix.mjs",
    "test": "npm run build && node test/host-test.mjs && node test/aggregate-test.mjs && node test/view-test.mjs && node test/client-smoke-test.mjs && node test/tui-test.mjs && node test/golden-test.mjs && node test/style-test.mjs && node test/manifest-test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-harness-tui/dsh-tui": "0.13.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-harness-tui/dsh-tui": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false,
      "external": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-store"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
