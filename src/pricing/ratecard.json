  "providers": [
    {
      "id": "zai-coding",
      "label": "GLM Coding Plan",
      "short": "GLM",
      "routes": ["zai-coding-cn", "zai-coding", "zai"],
      "envKeys": ["ZAI_CODING_CN_API_KEY", "GLM_CODING_CN_API_KEY", "ZAI_API_KEY", "GLM_API_KEY"],
      "hosts": [
        { "route": "zai-coding-cn", "base": "https://open.bigmodel.cn" },
        { "base": "https://api.z.ai" }
      ],
      "auth": "bearer",
      "requests": [
        { "id": "quota", "path": "/api/monitor/usage/quota/limit" },
        { "id": "sub", "path": "/api/biz/subscription/list", "optional": true }
      ],
      "windows": [
        {
          "kind": "tokens",
          "requirePct": false,
          "source": { "request": "quota", "path": "data.limits", "mode": "array", "filter": { "type": "TOKENS_LIMIT" } },
          "idFrom": {
            "fields": ["unit", "number"],
            "map": {
              "3|5": { "id": "5h", "windowMs": 18000000 },
              "6|1": { "id": "7d", "windowMs": 604800000 },
              "6|7": { "id": "7d", "windowMs": 604800000 },
              "5|1": { "id": "month", "windowMs": 2592000000 }
            },
            "fallback": "u{unit}n{number}"
          },
          "pct": { "aliases": ["percentage"] },
          "reset": { "aliases": ["nextResetTime"] }
        }
      ],
      "extras": [
        {
          "id": "tools",
          "source": { "request": "quota", "path": "data.limits", "mode": "array", "filter": { "type": "TIME_LIMIT" } },
          "pct": { "aliases": ["percentage"], "fallback": { "ratio": { "used": ["currentValue"], "total": ["usage"] } } },
          "used": { "aliases": ["currentValue"] },
          "total": { "aliases": ["usage"] },
          "reset": { "aliases": ["nextResetTime"] }
        }
      ],
      "plan": {
        "find": { "request": "sub", "path": "data", "where": { "status": "VALID" }, "requireString": "productName" },
        "fields": { "name": "productName", "cycle": "billingCycle", "renewsAt": "nextRenewTime" },
        "level": { "request": "quota", "path": "data.level" },
        "fee": { "amount": ["actualPrice", "initialPrice"], "currency": "CNY", "cycleField": "billingCycle" }
      }
    },
    {
      "id": "kimi-coding",
      "label": "Kimi For Coding",
      "short": "Kimi",
      "routes": ["kimi-coding", "kimi"],
      "envKeys": ["KIMI_CODING_API_KEY", "KIMI_API_KEY"],
      "hosts": [ { "base": "https://api.kimi.com" } ],
      "auth": "bearer",
      "requests": [ { "id": "quota", "path": "/coding/v1/usages" } ],
      "windows": [
        {
          "id": "7d", "kind": "requests", "windowMs": 604800000,
          "source": { "request": "quota", "path": "usage", "mode": "single" },
          "pct": { "ratio": { "used": ["used"], "total": ["limit"] } },
          "reset": { "aliases": ["resetTime"] }
        },
        {
          "kind": "requests",
          "source": {
            "request": "quota", "path": "usages", "mode": "map",
            "keys": {
              "limit_5h": { "id": "5h", "windowMs": 18000000 },
              "limit_7d": { "id": "7d", "windowMs": 604800000 }
            }
          },
          "pct": { "aliases": ["used_ratio"], "transform": "ratio" },
          "reset": { "aliases": ["reset_time"] }
        }
      ],
      "plan": { "name": "Kimi For Coding", "level": { "request": "quota", "path": "user.membership.level" } }
    },
    {
      "id": "minimax",
      "label": "MiniMax Coding Plan",
      "short": "MiniMax",
      "routes": ["minimax", "minimax-coding", "minimax-cn"],
      "envKeys": ["MINIMAX_API_KEY", "MINIMAX_CODING_API_KEY"],
      "hosts": [ { "base": "https://api.minimaxi.com" } ],
      "auth": "bearer",
      "requests": [ { "id": "quota", "path": "/v1/token_plan/remains" } ],
      "errorGate": { "request": "quota", "path": "base_resp", "field": "status_code" },
      "windows": [
        {
          "id": "5h", "kind": "requests", "windowMs": 18000000,
          "source": { "request": "quota", "path": "model_remains", "mode": "array", "fold": "max" },
          "pct": {
            "aliases": ["current_interval_remaining_percent"],
            "fallback": { "remaining": { "remaining": ["current_interval_usage_count"], "total": ["current_interval_total_count"] } }
          },
          "counts": { "total": ["current_interval_total_count"], "remaining": ["current_interval_usage_count"], "deriveUsed": true },
          "reset": { "aliases": ["end_time", "remains_time"] }
        },
        {
          "id": "7d", "kind": "requests", "windowMs": 604800000,
          "source": { "request": "quota", "path": "model_remains", "mode": "array", "fold": "max" },
          "pct": {
            "aliases": ["current_weekly_remaining_percent"],
            "fallback": { "remaining": { "remaining": ["current_weekly_usage_count"], "total": ["current_weekly_total_count"] } }
          },
          "counts": { "total": ["current_weekly_total_count"], "remaining": ["current_weekly_usage_count"], "deriveUsed": true },
          "reset": { "aliases": ["weekly_end_time", "remains_time"] }
        }
      ],
      "plan": { "name": "MiniMax Coding Plan" }
    },
    {
      "id": "opencode-go",
      "label": "OpenCode Go",
      "short": "OpenCode",
      "routes": ["opencode-go", "opencode", "opencode-zen"],
      "envKeys": ["OPENCODE_GO_API_KEY", "OPENCODE_API_KEY", "OPENCODE_ZEN_API_KEY"],
      "hosts": [ { "base": "https://opencode.ai" } ],
      "auth": "bearer",
      "requests": [ { "id": "quota", "path": "/zen/go/v1/usage" } ],
      "windows": [
        {
          "kind": "usd",
          "source": {
            "request": "quota", "path": "usage", "mode": "map",
            "keys": {
              "rolling": { "id": "5h", "windowMs": 18000000 },
              "weekly": { "id": "7d", "windowMs": 604800000 },
              "monthly": { "id": "month", "windowMs": 2592000000 }
            }
          },
          "pct": { "aliases": ["usagePercent", "usedPercent", "percentUsed", "percent", "usage_percent", "used_percent"] },
          "counts": { "used": ["usedMicroCents"], "total": ["limitMicroCents"], "transform": "microCentsUsd" },
          "reset": {
            "aliases": ["resetAt", "resetsAt", "nextResetAt", "nextReset"],
            "inSec": ["resetInSec", "resetInSeconds", "resetSeconds", "resetsInSec"]
          }
        }
      ],
      "plan": { "name": "OpenCode Go", "fee": { "amount": 10, "currency": "USD", "cycle": "monthly" } }
    }
  ]
}
