{
  "name": "dsh-pulse",
  "version": "0.6.1",
  "description": "Usage & cost observatory for dsh: session-folded token trends, official-rate cost estimates, balance and subscription quotas, anomaly watch — as a web panel and an optional dsh-tui terminal face",
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2 <0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enc-hanted/dsh-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/Enc-hanted/dsh-pulse/issues"
  },
  "homepage": "https://github.com/Enc-hanted/dsh-pulse#readme",
  "exports": {
    ".": "./src/index.js",
    "./aggregate": "./src/aggregate.js",
    "./view": "./src/view.js",
    "./client": "./lib/client.js",
    "./tui": "./src/tui.js",
    "./pricing": "./src/pricing/index.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "lib/client.js",
    "locale",
    "assets/logo.svg",
    "assets/logo-dark.svg",
    "assets/icon.svg",
    "assets/shots",
    "docs",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "usage",
    "usage-analytics",
    "cost",
    "billing",
    "token",
    "analytics",
    "dashboard",
    "heatmap"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:types": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run build && node test/host-test.mjs && node test/aggregate-test.mjs && node test/view-test.mjs && node test/quota-adapters-test.mjs && node packages/dsh-pulse-usage-query/test/shape-test.mjs && node test/client-smoke-test.mjs && node test/tui-test.mjs && node test/golden-test.mjs && node test/style-test.mjs && node test/manifest-test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2 <0.3",
    "@deepseek-harness-tui/dsh-tui": ">=0.13.0 <0.17"
  },
  "peerDependenciesMeta": {
    "@deepseek-harness-tui/dsh-tui": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false,
      "external": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-store"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
