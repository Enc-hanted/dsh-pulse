{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "resolveJsonModule": true,
    "checkJs": true,
    "noImplicitAny": false,
    "strict": false,
    "strictNullChecks": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "types-shims/**/*.d.ts"],
  "exclude": ["src/client/**"]
}
